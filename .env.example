# Copia este archivo como .env y llena cada valor vacío antes de arrancar.
# Ningún secreto tiene valor por omisión: con este archivo tal cual, el servidor
# no arranca.

# Clave que sella la cookie de sesión. Obligatoria: sin ella, o con menos de 32
# caracteres, el servidor no arranca. Agrégala al .env sin que pase por la
# terminal:
#   printf '\nNUXT_SESSION_PASSWORD=%s\n' "$(openssl rand -base64 32)" >> .env
NUXT_SESSION_PASSWORD=

# PostgreSQL en Docker Compose. `bun run db:up` falla si falta alguna de las tres
# contraseñas. Genera cada una con: openssl rand -hex 24
# Van en hexadecimal porque también se escriben dentro de las URL de abajo.
# Solo se aplican con el volumen vacío: cambiarlas después exige ALTER ROLE.
POSTGRES_PORT=55432
POSTGRES_PASSWORD=
PALCO_APP_PASSWORD=
PALCO_LECTOR_PASSWORD=

# Sin valor por omisión. Cada URL repite su contraseña de arriba y POSTGRES_PORT:
#   NUXT_DATABASE_URL=postgres://palco_app:<PALCO_APP_PASSWORD>@127.0.0.1:55432/palco
#   NUXT_DATABASE_READER_URL=postgres://palco_lector:<PALCO_LECTOR_PASSWORD>@127.0.0.1:55432/palco
#   NUXT_DATABASE_ADMIN_URL=postgres://palco_admin:<POSTGRES_PASSWORD>@127.0.0.1:55432/palco
NUXT_DATABASE_URL=
NUXT_DATABASE_READER_URL=
NUXT_DATABASE_ADMIN_URL=

# Clave de firma de los QR de los boletos: la semilla Ed25519 de 32 bytes en
# base64. Vacía, cada ejecución firma con su propia clave y los QR impresos antes
# de un reinicio dejan de verificar; el código corto sigue sirviendo. Con un valor
# inválido, el servidor no arranca. Agrégala al .env sin que pase por la terminal:
#   printf '\nNUXT_TICKET_SIGNING_KEY=%s\n' "$(openssl rand -base64 32)" >> .env
NUXT_TICKET_SIGNING_KEY=

# Clave de taquilla de /acceso (RN-ACC-01): de 6 a 64 caracteres ASCII, sin
# espacios. Vacía o inválida, la taquilla no está disponible y la página lo dice.
# Cambiarla cierra las taquillas abiertas. Genera una con:
#   printf '\nNUXT_GATE_PIN=%s\n' "$(openssl rand -hex 8)" >> .env
NUXT_GATE_PIN=

# Asientos libres iniciales por recinto, para demostrar el agotado.
# Sin ella, todos los recintos arrancan con el aforo completo.
# NUXT_AVAILABILITY_OVERRIDES=teatro-scala=5,mna=0

# Intentos de registro por IP, «intentos/segundos» (RN-REG-07).
# Sin ella, 5 intentos en 15 minutos. 2/10 sirve para demostrar la ventana.
# NUXT_REGISTRATION_RATE_LIMIT=5/900

# Envío de boletos por WhatsApp Business. Las cinco primeras no tienen valor por
# omisión: si falta alguna, el envío no está disponible y la interfaz lo dice
# (RF-ENV-09). Nunca se escriben en el código ni en los registros. El token, el id
# del número y el de la cuenta se obtienen en el panel de desarrolladores de Meta;
# usa el token de un usuario de sistema, que no vence.
NUXT_WHATSAPP_ACCESS_TOKEN=
NUXT_WHATSAPP_PHONE_NUMBER_ID=
NUXT_WHATSAPP_BUSINESS_ACCOUNT_ID=
# Plantilla activa: palco_boletos_v2; idioma aprobado: es_MX.
# La original palco_boletos sigue admitida con sus cuatro parámetros.
NUXT_WHATSAPP_TICKET_TEMPLATE=palco_boletos_v2
NUXT_WHATSAPP_TEMPLATE_LANGUAGE=es_MX
# Dirección de la API de Meta: https://, o http:// solo hacia 127.0.0.1 o
# localhost, para un servidor local que la imite. Vacía, graph.facebook.com.
NUXT_WHATSAPP_API_BASE=
# Versión de la Graph API. Vacía, v26.0.
NUXT_WHATSAPP_API_VERSION=
