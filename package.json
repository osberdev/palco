{
  "name": "palco",
  "version": "1.0.0",
  "description": "Sistema web de venta de boletos para eventos culturales en doce recintos de siete países",
  "author": "Oscar Alejandro Bermúdez Cota",
  "repository": "https://github.com/osberdev/palco",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "start": "node --env-file-if-exists=.env --import ./scripts/resolve-ts.ts scripts/start-check.ts && node --env-file-if-exists=.env .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:init": "node --env-file-if-exists=.env --import ./scripts/resolve-ts.ts scripts/db-init.ts",
    "db:seed": "node --env-file-if-exists=.env --import ./scripts/resolve-ts.ts scripts/db-seed.ts",
    "db:seed:demo": "node --env-file-if-exists=.env --import ./scripts/resolve-ts.ts scripts/db-seed-demo.ts",
    "db:reset": "node --env-file-if-exists=.env --import ./scripts/resolve-ts.ts scripts/db-reset.ts",
    "db:evidence": "node --env-file-if-exists=.env --import ./scripts/resolve-ts.ts scripts/db-evidence.ts",
    "whatsapp:check": "node --env-file-if-exists=.env scripts/whatsapp-check.ts",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:concurrency": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.concurrency.config.ts"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.10.3",
    "@pinia/nuxt": "0.11.2",
    "bcrypt": "^5.1.1",
    "libphonenumber-js": "1.13.14",
    "nuxt": "^3.15.0",
    "pdfmake": "0.3.11",
    "pg": "8.23.1",
    "pinia": "^3.0.4",
    "uqr": "0.1.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@nuxt/eslint": "^0.7.4",
    "@types/bcrypt": "^5.0.2",
    "@types/pg": "8.23.1",
    "eslint": "^9.17.0",
    "ofetch": "^1.5.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  },
  "trustedDependencies": [
    "bcrypt",
    "unrs-resolver"
  ]
}
